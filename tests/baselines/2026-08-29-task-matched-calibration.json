  "findings": {
    "task_bias_confirmed": {
      "J-2 따옴표": "사람 11.36 / AI기존 0.00 / AI과업 26.89. '기존 AI는 따옴표를 안 쓴다'는 전적으로 과업 산물이었다. 과업을 맞추면 **AI가 사람보다 2.4배 더 쓴다** — 규칙 방향(줄여라)이 이 조건에서 옳다.",
      "H-1 문두접속사": "사람 0.43 / AI기존 2.29 / AI과업 0.13. 과업을 맞추면 AI가 사람보다 **적게** 쓴다. 모델 의존(haiku 단독)에 더해 과업 의존까지 확인 — 보수화 조치가 옳다.",
      "D-4 hype": "사람 0.26 / AI기존 0.34 / AI과업 0.00. 취재·인용 과업에서는 AI가 hype 어휘를 쓰지 않는다. 근거 약함."
    },
    "task_invariant": {
      "C-8 대구": "0.52 / 6.30 / 6.13 — 과업을 바꿔도 12배가 유지된다. 세 측정(24쌍 9.2배, n=60 12.1배, 과업매칭 11.8배) 모두에서 최강 신호.",
      "I-4 당위": "1.64 / 6.07 / 3.39 — 과업을 맞추면 3.7배에서 2.1배로 줄지만 여전히 초과.",
      "F-5 추상체인": "3.87 / 6.07 / 5.48 — 1.6배에서 1.4배. 경계선이지만 방향 유지."
    },
    "still_undecided": {
      "G-3 안전균형": "사람 1건 대 AI 4건 수준의 희소 패턴이라 과업 대조군에서도 판정 불가. hold 유지.",
      "A-16 대명사": "사람 10.67 vs AI 4.24~5.22 — 과업과 무관하게 사람이 2배 더 쓴다. 번역 맥락 한정 조치 재확인."
    }
  }
